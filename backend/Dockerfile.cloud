FROM rust:1-bookworm AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock* ./
COPY robot-fleet-common ./robot-fleet-common
COPY backend ./backend
COPY robot-simulator ./robot-simulator
RUN cargo build --release -p robot-fleet-backend

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/target/release/robot-fleet-backend /usr/local/bin/robot-fleet-backend
COPY backend/migrations ./migrations
ENV HTTP_PORT=8080
EXPOSE 8080
CMD ["robot-fleet-backend"]
