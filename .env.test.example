# Terraform variables for the test environment.
GCP_PROJECT_ID="robot-fleet-your-unique-name"
GCP_REGION="europe-west1"
GCP_ZONE="europe-west1-b"
GCP_ARTIFACT_REGISTRY_HOST="${GCP_REGION}-docker.pkg.dev"
GCP_IMAGE_REPOSITORY="${GCP_PROJECT_ID}/robot-fleet-test-images"

TF_VAR_cloud_vendor="google"
TF_VAR_gcp_project_id="${GCP_PROJECT_ID}"
TF_VAR_gcp_region="${GCP_REGION}"
TF_VAR_gcp_zone="${GCP_ZONE}"
TF_VAR_backend_image="${GCP_ARTIFACT_REGISTRY_HOST}/${GCP_IMAGE_REPOSITORY}/backend:latest"
TF_VAR_web_image="${GCP_ARTIFACT_REGISTRY_HOST}/${GCP_IMAGE_REPOSITORY}/web:latest"
TF_VAR_robot_image="${GCP_ARTIFACT_REGISTRY_HOST}/${GCP_IMAGE_REPOSITORY}/robot-simulator:latest"
TF_VAR_database_tier="db-custom-1-3840"
TF_VAR_vm_machine_type="e2-micro"
