{
  "name": "robot-fleet-web-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "start": "node build"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "^5.2.0",
    "@sveltejs/kit": "^2.22.0",
    "svelte": "^5.34.0",
    "vite": "^6.3.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@types/node": "^22.10.0",
    "svelte-check": "^4.2.0",
    "typescript": "^5.8.0"
  }
}
